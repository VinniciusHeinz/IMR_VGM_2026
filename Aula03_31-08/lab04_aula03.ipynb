import pygame
import math
import numpy as np

LARGURA, ALTURA = 900, 650
FPS = 60
COR_FUNDO = (20, 24, 30)
COR_ROBO = (0, 200, 255)
COR_OBSTACULO = (180, 50, 50)
COR_RAIO_LIVRE = (0, 255, 100)
COR_RAIO_COLISAO = (255, 200, 0)

class BraitenbergVehicle:
    def __init__(self, x, y, theta=0.0):
        self.x = float(x)
        self.y = float(y)
        self.theta = float(theta)
        self.L = 30.0  # Distância entre rodas (base)
        self.v_base = 100.0  # px/s
        self.S_max = 160.0
        self.Ks = 0.8
        self.sensor_angles = [-math.pi / 4, 0.0, math.pi / 4]  # Esq, Centro, Dir
        self.readings = [self.S_max] * 3

    def cast_rays(self, obstacles):
        self.readings = []
        for beta in self.sensor_angles:
            angle = self.theta + beta
            min_dist = self.S_max
            for step in range(5, int(self.S_max), 3):
                rx = self.x + step * math.cos(angle)
                ry = self.y + step * math.sin(angle)
                if rx <= 0 or rx >= LARGURA or ry <= 0 or ry >= ALTURA:
                    min_dist = float(step)
                    break
                hit = False
                for obs in obstacles:
                    if obs.collidepoint(rx, ry):
                        min_dist = float(step)
                        hit = True
                        break
                if hit:
                    break
            self.readings.append(min_dist)

    def update(self, dt):
        s_esq, s_frente, s_dir = self.readings

        # Condição de emergência frontal (< 40 px)
        if s_frente < 40.0:
            v_L = -80.0
            v_R = 80.0
        else:
            # Lei do Veículo de Braitenberg (Medo Puro)
            v_L = self.v_base + self.Ks * (self.S_max - s_dir)
            v_R = self.v_base + self.Ks * (self.S_max - s_esq)

        # Cinemática Diferencial Direta
        v = (v_R + v_L) / 2.0
        omega = (v_R - v_L) / self.L

        self.theta += omega * dt
        self.x += v * math.cos(self.theta) * dt
        self.y += v * math.sin(self.theta) * dt

        # Bounding box interno de segurança
        self.x = max(20, min(LARGURA - 20, self.x))
        self.y = max(20, min(ALTURA - 20, self.y))

    def draw(self, surface):
        for i, beta in enumerate(self.sensor_angles):
            angle = self.theta + beta
            dist = self.readings[i]
            rx = self.x + dist * math.cos(angle)
            ry = self.y + dist * math.sin(angle)
            cor = COR_RAIO_COLISAO if dist < self.S_max else COR_RAIO_LIVRE
            pygame.draw.line(surface, cor, (int(self.x), int(self.y)), (int(rx), int(ry)), 2)

        pos = (int(self.x), int(self.y))
        pygame.draw.circle(surface, COR_ROBO, pos, 15)
        fx = self.x + 20 * math.cos(self.theta)
        fy = self.y + 20 * math.sin(self.theta)
        pygame.draw.line(surface, (255, 50, 50), pos, (int(fx), int(fy)), 3)

def main():
    pygame.init()
    screen = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("Lab 4: Veiculo de Braitenberg - Medo Puro")
    clock = pygame.time.Clock()
    font = pygame.font.SysFont("monospace", 14)

    robot = BraitenbergVehicle(100, 100, 0.5)
    obstacles = [
        pygame.Rect(250, 120, 80, 250),
        pygame.Rect(500, 300, 100, 200),
        pygame.Rect(700, 100, 100, 150),
        pygame.Rect(200, 450, 180, 80)
    ]

    running = True
    while running:
        dt = clock.tick(FPS) / 1000.0
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

        robot.cast_rays(obstacles)
        robot.update(dt)

        screen.fill(COR_FUNDO)
        for obs in obstacles:
            pygame.draw.rect(screen, COR_OBSTACULO, obs)
            pygame.draw.rect(screen, (255, 100, 100), obs, 2)
        
        robot.draw(screen)

        screen.blit(font.render("Lab 04: Navegacao Reativa Braitenberg (Medo Puro)", True, (255, 215, 0)), (20, 20))
        screen.blit(font.render(f"Sensores: Esq={robot.readings[0]:.1f} | Frente={robot.readings[1]:.1f} | Dir={robot.readings[2]:.1f}", True, (200, 200, 200)), (20, 45))

        pygame.display.flip()
    pygame.quit()

if __name__ == "__main__":
    main()