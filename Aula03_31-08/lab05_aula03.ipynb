import pygame
import math
import numpy as np

LARGURA, ALTURA = 900, 650
FPS = 60
COR_FUNDO = (20, 24, 30)
COR_ROBO = (0, 200, 255)
COR_OBSTACULO = (180, 50, 50)
COR_ALVO = (255, 215, 0)

class GoToGoalRobot:
    def __init__(self, x, y):
        self.x = float(x)
        self.y = float(y)
        self.theta = 0.0
        self.sensor_angles = [-math.pi / 4, 0.0, math.pi / 4]  # Esq (-), Frente (0), Dir (+)
        self.sensor_range = 150.0
        self.readings = [self.sensor_range] * 3
        self.target = None
        self.v_nominal = 90.0
        self.Kp_ang = 4.0
        self.K_obs = 180.0

    def cast_rays(self, obstacles):
        self.readings = []
        for beta in self.sensor_angles:
            angle = self.theta + beta
            min_dist = self.sensor_range
            for step in range(5, int(self.sensor_range), 3):
                rx = self.x + step * math.cos(angle)
                ry = self.y + step * math.sin(angle)
                if rx <= 0 or rx >= LARGURA or ry <= 0 or ry >= ALTURA:
                    min_dist = float(step)
                    break
                hit = False
                for obs in obstacles:
                    if obs.collidepoint(rx, ry):
                        min_dist = float(step)
                        hit = True
                        break
                if hit:
                    break
            self.readings.append(min_dist)

    def update(self, dt):
        if self.target is None:
            return

        tx, ty = self.target
        dx, dy = tx - self.x, ty - self.y
        dist_target = math.hypot(dx, dy)

        # Condição de parada (< 15 px)
        if dist_target < 15.0:
            return

        # Modo 1: Atração ao Alvo (Controle Proporcional)
        ang_alvo = math.atan2(dy, dx)
        erro_ang = math.atan2(math.sin(ang_alvo - self.theta), math.cos(ang_alvo - self.theta))
        omega_alvo = self.Kp_ang * erro_ang

        # Modo 2: Desvio de Emergência
        omega_repulsao = 0.0
        for i, beta in enumerate(self.sensor_angles):
            s_i = self.readings[i]
            if s_i < 60.0:
                # sign(beta_i): sensor à dir (+) gira p/ esq (-); sensor à esq (-) gira p/ dir (+)
                # Se beta == 0 (frontal), desvia arbitrariamente p/ esquerda
                sinal = 1.0 if beta > 0 else (-1.0 if beta < 0 else -1.0)
                omega_repulsao += (-sinal) * (self.K_obs / max(10.0, s_i))

        omega_total = omega_alvo + omega_repulsao
        v = self.v_nominal if abs(erro_ang) < math.pi / 3 else self.v_nominal * 0.3

        self.theta += omega_total * dt
        self.x += v * math.cos(self.theta) * dt
        self.y += v * math.sin(self.theta) * dt

    def draw(self, surface):
        if self.target:
            pygame.draw.circle(surface, COR_ALVO, self.target, 8)
            pygame.draw.circle(surface, (255, 255, 255), self.target, 12, 1)

        for i, beta in enumerate(self.sensor_angles):
            angle = self.theta + beta
            dist = self.readings[i]
            rx = self.x + dist * math.cos(angle)
            ry = self.y + dist * math.sin(angle)
            cor = (255, 100, 0) if dist < 60.0 else (0, 255, 100)
            pygame.draw.line(surface, cor, (int(self.x), int(self.y)), (int(rx), int(ry)), 2)

        pos = (int(self.x), int(self.y))
        pygame.draw.circle(surface, COR_ROBO, pos, 15)
        fx = self.x + 22 * math.cos(self.theta)
        fy = self.y + 22 * math.sin(self.theta)
        pygame.draw.line(surface, (255, 50, 50), pos, (int(fx), int(fy)), 3)

def main():
    pygame.init()
    screen = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("Lab 5: Navegador Reativo Go-to-Goal com Desvio")
    clock = pygame.time.Clock()
    font = pygame.font.SysFont("monospace", 14)

    robot = GoToGoalRobot(100, 100)
    obstacles = [
        pygame.Rect(350, 150, 120, 320),
        pygame.Rect(600, 100, 120, 180),
        pygame.Rect(180, 380, 120, 120)
    ]

    running = True
    while running:
        dt = clock.tick(FPS) / 1000.0
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                robot.target = event.pos

        robot.cast_rays(obstacles)
        robot.update(dt)

        screen.fill(COR_FUNDO)
        for obs in obstacles:
            pygame.draw.rect(screen, COR_OBSTACULO, obs)
            pygame.draw.rect(screen, (255, 100, 100), obs, 2)
        
        robot.draw(screen)

        screen.blit(font.render("Lab 05: Clique na tela para definir o Alvo (Go-to-Goal)", True, (255, 215, 0)), (20, 20))
        dist_str = f"Distancia do Alvo: {math.hypot(robot.target[0]-robot.x, robot.target[1]-robot.y):.1f} px" if robot.target else "Alvo: Nenhum"
        screen.blit(font.render(dist_str, True, (200, 200, 200)), (20, 45))

        pygame.display.flip()
    pygame.quit()

if __name__ == "__main__":
    main()