import pygame
import math
import time

LARGURA, ALTURA = 600, 600
FPS = 60
COR_FUNDO = (20, 24, 30)
COR_ROBO = (0, 200, 255)

pygame.init()
screen = pygame.display.set_mode((LARGURA, ALTURA))
pygame.display.set_caption("Lab 2 - Rotacao In-Place (90 deg)")
clock = pygame.time.Clock()
font = pygame.font.SysFont("monospace", 15)

x, y = LARGURA // 2, ALTURA // 2
theta = 0.0  # Orientação inicial (radianos)
omega_z = 0.5  # rad/s
tempo_giro = math.pi / omega_z  # 3.14159s

tempo_inicio = time.time()
girando = True
running = True

while running:
    dt = clock.tick(FPS) / 1000.0
    tempo_passado = time.time() - tempo_inicio

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # Controle em malha aberta por tempo
    if tempo_passado < tempo_giro:
        theta += omega_z * dt  # Sentido anti-horário
    else:
        omega_z = 0.0  # Zeramento de velocidade[cite: 1]
        girando = False

    screen.fill(COR_FUNDO)

    # Desenho do robô e vetor de orientação
    pos = (int(x), int(y))
    pygame.draw.circle(screen, COR_ROBO, pos, 20)
    fx = x + 35 * math.cos(theta)
    fy = y - 35 * math.sin(theta)  # Inversão do eixo Y do pygame
    pygame.draw.line(screen, (255, 50, 50), pos, (int(fx), int(fy)), 4)

    # Telemetria
    status = "GIRANDO" if girando else "FINALIZADO (PARADO)"
    screen.blit(font.render(f"Status: {status}", True, (255, 255, 255)), (20, 20))
    screen.blit(font.render(f"Theta: {math.degrees(theta):.1f}° ({theta:.2f} rad)", True, (220, 220, 220)), (20, 45))
    screen.blit(font.render(f"Tempo decorrido: {tempo_passado:.2f} s / {tempo_giro:.2f} s", True, (220, 220, 220)), (20, 70))

    pygame.display.flip()

pygame.quit()