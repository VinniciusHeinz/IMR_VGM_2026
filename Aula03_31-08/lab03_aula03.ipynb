import pygame
import math
import numpy as np

LARGURA, ALTURA = 900, 650
FPS = 60
COR_FUNDO = (20, 24, 30)
COR_ROBO = (0, 200, 255)
COR_OBSTACULO = (180, 50, 50)
COR_RAIO_LIVRE = (0, 255, 100)
COR_RAIO_COLISAO = (255, 200, 0)

class MultiBeamRobot:
    def __init__(self, x, y):
        self.x = float(x)
        self.y = float(y)
        self.theta = 0.0
        # 5 Feixes: -60°, -30°, 0°, +30°, +60°
        self.sensor_angles = [math.radians(deg) for deg in [-60, -30, 0, 30, 60]]
        self.sensor_range = 200.0
        self.readings_clean = [self.sensor_range] * 5
        self.readings_noisy = [self.sensor_range] * 5

    def cast_rays(self, obstacles):
        self.readings_clean = []
        self.readings_noisy = []
        
        for beta in self.sensor_angles:
            angle = self.theta + beta
            min_dist = self.sensor_range
            
            for step in range(5, int(self.sensor_range), 3):
                rx = self.x + step * math.cos(angle)
                ry = self.y + step * math.sin(angle)
                
                # Paredes externas
                if rx <= 0 or rx >= LARGURA or ry <= 0 or ry >= ALTURA:
                    min_dist = float(step)
                    break
                    
                # Obstáculos
                hit = False
                for obs in obstacles:
                    if obs.collidepoint(rx, ry):
                        min_dist = float(step)
                        hit = True
                        break
                if hit:
                    break
            
            self.readings_clean.append(min_dist)
            
            # Adiciona Ruído Gaussiano: N(0, 2.0)
            noise = float(np.random.normal(0.0, 2.0))
            noisy_val = max(0.0, min(self.sensor_range, min_dist + noise))
            self.readings_noisy.append(noisy_val)

    def draw(self, surface, font):
        for i, beta in enumerate(self.sensor_angles):
            angle = self.theta + beta
            dist = self.readings_noisy[i]
            rx = self.x + dist * math.cos(angle)
            ry = self.y + dist * math.sin(angle)
            
            cor = COR_RAIO_COLISAO if dist < self.sensor_range - 2 else COR_RAIO_LIVRE
            pygame.draw.line(surface, cor, (int(self.x), int(self.y)), (int(rx), int(ry)), 2)
            pygame.draw.circle(surface, cor, (int(rx), int(ry)), 4)
            
            # Renderizar valor numérico do sensor no raio
            label = font.render(f"{dist:.1f}px", True, (255, 255, 255))
            surface.blit(label, (int(rx) + 5, int(ry) - 10))
            
        pos = (int(self.x), int(self.y))
        pygame.draw.circle(surface, COR_ROBO, pos, 16)
        fx = self.x + 22 * math.cos(self.theta)
        fy = self.y + 22 * math.sin(self.theta)
        pygame.draw.line(surface, (255, 50, 50), pos, (int(fx), int(fy)), 3)

def main():
    pygame.init()
    screen = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("Lab 3: Percepcao com 5 Feixes e Ruido Gaussiano")
    clock = pygame.time.Clock()
    font = pygame.font.SysFont("monospace", 12)
    hud_font = pygame.font.SysFont("monospace", 14)

    robot = MultiBeamRobot(200, 300)
    obstacles = [
        pygame.Rect(400, 150, 100, 300),
        pygame.Rect(650, 100, 120, 150),
        pygame.Rect(150, 450, 150, 100),
        pygame.Rect(650, 400, 150, 150)
    ]

    running = True
    while running:
        clock.tick(FPS)
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

        mx, my = pygame.mouse.get_pos()
        dx, dy = mx - robot.x, my - robot.y
        robot.theta = math.atan2(dy, dx)
        robot.x += dx * 0.03
        robot.y += dy * 0.03

        robot.cast_rays(obstacles)

        screen.fill(COR_FUNDO)
        for obs in obstacles:
            pygame.draw.rect(screen, COR_OBSTACULO, obs)
            pygame.draw.rect(screen, (255, 100, 100), obs, 2)
        
        robot.draw(screen, font)

        screen.blit(hud_font.render("Lab 03: 5 Sensores com Ruido Gaussiano N(0, 2.0)", True, (255, 215, 0)), (20, 20))
        for i, val in enumerate(robot.readings_noisy):
            screen.blit(hud_font.render(f"Feixe {i+1}: {val:5.1f} px", True, (220, 220, 220)), (20, 45 + i * 20))

        pygame.display.flip()
    pygame.quit()

if __name__ == "__main__":
    main()